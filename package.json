{
  "name": "client-super-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev --hostname dev.lumosapp.net --port 3000 --experimental-https",
    "dev:no-tls": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 pnpm dev:host",
    "build": "next build",
    "build:production": "pnpm build",
    "start": "next start",
    "stylelint:check": "npx stylelint \"src/**/*.{scss,css}\" --allow-empty-input",
    "stylelint:fix": "stylelint --fix src/{,*/}*.{scss,css} --allow-empty-input",
    "lint": "eslint --ext .jsx,.js,.tsx,.ts --no-error-on-unmatched-pattern --fix",
    "lint:check": "eslint .",
    "format": "prettier . --write .",
    "format:check": "prettier . --check",
    "type:check": "tsc -b --noEmit",
    "check": "pnpm type:check && pnpm lint:check && pnpm stylelint:check && pnpm format:check",
    "prepare": "husky",
    "dev:server": "nodemon src/json-server/index.js"
  },
  "dependencies": {
    "@candy.thieves/ui-kit-lumos": "^0.0.75",
    "@hookform/resolvers": "^7.0.6",
    "@it-incubator/prettier-config": "^0.1.2",
    "@it-incubator/stylelint-config": "^2.0.0",
    "@lottiefiles/dotlottie-react": "^0.22.2",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^17.6.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "react-loading-skeleton": "^3.5.0",
    "sass": "^1.108.2",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@11.22.0",
  "lint-staged": {
    "**/*.{jsx,js,tsx,ts}": [
      "eslint src --ext .jsx,.js,.tsx,.ts --fix --quiet --no-error-on-unmatched-pattern"
    ],
    "**/*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "**/*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
